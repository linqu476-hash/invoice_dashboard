# Copy to .streamlit/secrets.toml (local) or paste into the host's "Secrets" box (Streamlit Community Cloud).
# The app refuses to start without a password: it handles customer addresses and invoice data.

# RECOMMENDED: store only a hash. Make it with:  python scripts/make_password_hash.py
APP_PASSWORD_HASH = "scrypt$16384$8$1$paste-the-line-the-script-printed"
# Still accepted when no hash is set (the password is then stored in clear text in the secrets):
# APP_PASSWORD = "change-me-to-a-long-passphrase"

# Optional session limits (defaults shown)
# IDLE_TIMEOUT_MIN = 30
# MAX_SESSION_HOURS = 12

# Optional: where consignees / shipping marks are stored (default: data/invoice_dashboard.sqlite3).
# The audit log and the sign-in lockout file are kept next to it.
# INVOICE_DB_PATH = "/var/data/invoice.sqlite3"
